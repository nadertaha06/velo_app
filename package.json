{
  "name": "velo-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@hookform/resolvers": "^7.0.9",
    "@tanstack/react-query": "^5.108.4",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.80.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "openapi-typescript": "^7.13.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "gen:api": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/openapi.json} -o src/api/schema.d.ts",
    "check": "tsc --noEmit && eslint . && jest",
    "check:api-drift": "bash scripts/check-api-drift.sh",
    "test:prod-bundle": "bash scripts/check-prod-bundle.sh",
    "test:e2e": "jest -c jest.e2e.config.js --runInBand"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|lucide-react-native|react-native-svg|openapi-fetch)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/"
    ]
  }
}
