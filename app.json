{
  "expo": {
    "name": "Velo",
    "slug": "velo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-symbol-black.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Velo usa suas fotos só para anunciar a vaga ou avisar que ela não estava livre.",
          "cameraPermission": "O Velo usa a câmera só para fotografar a vaga."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
